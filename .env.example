# ─────────────────────────────────────────────────────────────────
# FRAMEFOLK — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase (Public — safe to expose to the browser) ────────────
# Found in: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check — reCAPTCHA Enterprise site key (public)
NEXT_PUBLIC_FIREBASE_APP_CHECK_RECAPTCHA_KEY=

# ── Firebase Admin SDK (Server-side ONLY — never expose to browser) ──
# Option A: JSON string of service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Path to service account key file (local dev only)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firebase project ID (used by Admin SDK)
FIREBASE_PROJECT_ID=

# ── Cloudinary (Central account) ─────────────────────────────────
# Found in: Cloudinary Console → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# ⚠️  API Key is semi-public (used in signed upload params)
CLOUDINARY_API_KEY=
# ⚠️  API Secret MUST stay server-side only. NEVER prefix with NEXT_PUBLIC_
CLOUDINARY_API_SECRET=

# Cloudinary upload preset name (create in Cloudinary Console → Settings → Upload)
CLOUDINARY_UPLOAD_PRESET=framefolk_uploads

# ── FCM (Firebase Cloud Messaging) ───────────────────────────────
# VAPID key for Web Push — found in Firebase Console → Project Settings → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Feature Flags ────────────────────────────────────────────────
# Set to "true" to enable Google Sign-In on auth pages
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true

# Set to "true" to show install PWA prompt
NEXT_PUBLIC_ENABLE_PWA_PROMPT=true
