rules_version = '2';

// FRAMEFOLK — Firestore Security Rules
// Philosophy: authentication is the gate. Any signed-in user can use the platform.
// Moderators/admins handle abuse via the admin dashboard.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return isSignedIn() &&
        (request.auth.token.role == 'moderator' || request.auth.token.role == 'superAdmin');
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isModerator();
      allow delete: if false;
    }

    // ── usernames ──────────────────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn();
      allow update: if false;
    }

    // ── posts ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.authorUid == request.auth.uid)
                    || isModerator();
      allow delete: if false;

      match /likes/{likerUid} {
        allow read: if isSignedIn();
        allow create: if isOwner(likerUid);
        allow delete: if isOwner(likerUid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.authorUid == request.auth.uid;
        allow delete: if false;

        match /replies/{replyId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn()
                        && request.resource.data.authorUid == request.auth.uid;
          allow update: if isSignedIn()
                        && resource.data.authorUid == request.auth.uid;
          allow delete: if false;
        }
      }
    }

    // ── media ──────────────────────────────────────────────────────────────
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // ── stories ────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid;
      allow delete: if false;
    }

    // ── storyViews ─────────────────────────────────────────────────────────
    match /storyViews/{viewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.viewerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.viewerUid == request.auth.uid;
      allow delete: if false;
    }

    // ── storyHighlights ────────────────────────────────────────────────────
    match /storyHighlights/{highlightId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }

    // ── followers ──────────────────────────────────────────────────────────
    match /followers/{uid}/following/{targetUid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    match /followers/{uid}/followers/{sourceUid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    // ── followRequests ─────────────────────────────────────────────────────
    match /followRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.fromUid == request.auth.uid
                    || resource.data.toUid == request.auth.uid
                  );
      allow create: if isSignedIn()
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && (
                    resource.data.toUid == request.auth.uid
                    || resource.data.fromUid == request.auth.uid
                  );
      allow delete: if isSignedIn()
                    && resource.data.fromUid == request.auth.uid;
    }

    // ── conversations + messages ────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.senderUid == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.senderUid == request.auth.uid;
        allow delete: if false;
      }
    }

    // ── albums + members ───────────────────────────────────────────────────
    match /albums/{albumId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /albumMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && resource.data.recipientUid == request.auth.uid;
      allow delete: if false;
    }

    // ── notificationPrefs ──────────────────────────────────────────────────
    match /notificationPrefs/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // ── bookmarks ──────────────────────────────────────────────────────────
    match /bookmarks/{uid}/saved/{postId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    // ── blocks ─────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isSignedIn() && (
                    resource.data.blockerUid == request.auth.uid
                    || resource.data.blockedUid == request.auth.uid
                  );
      allow create: if isSignedIn()
                    && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // ── reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
                    resource.data.reporterUid == request.auth.uid
                    || isModerator()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }

    // ── deletionRequests ───────────────────────────────────────────────────
    match /deletionRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.requesterUid == request.auth.uid
                    || isModerator()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.requesterUid == request.auth.uid;
      allow update: if isModerator();
      allow delete: if false;
    }

    // ── closeFriends ───────────────────────────────────────────────────────
    match /closeFriends/{uid}/members/{friendUid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    // ── admin-only ─────────────────────────────────────────────────────────
    match /roles/{uid} {
      allow read: if isModerator() || isOwner(uid);
      allow write: if false;
    }

    match /permissions/{uid} {
      allow read: if isModerator() || isOwner(uid);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update: if false;
      allow delete: if false;
    }

    // ── cloudinaryConnections ──────────────────────────────────────────────
    match /cloudinaryConnections/{connectionId} {
      allow read: if isSignedIn()
                  && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // ── invitations ────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
                    resource.data.inviterUid == request.auth.uid
                    || resource.data.inviteeUid == request.auth.uid
                  );
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && resource.data.inviteeUid == request.auth.uid;
      allow delete: if false;
    }

    // ── profiles ──────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
